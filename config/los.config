<?xml version="1.0" encoding="utf-8"?>
<!--
  MortgageLOS Application Configuration
  ====================================
  Last reviewed: 2019-03-15 (by someone who no longer works here)
  
  NOTE: The production values have been replaced with localhost defaults.
  DO NOT deploy this file to production without updating connection strings.
  (This happened in 2017. See incident report INC-2017-084.)
-->
<configuration>
  <connectionStrings>
    <!-- Core database - main loan data -->
    <add name="los_core" 
         connectionString="Host=localhost;Port=5433;Database=los_core;Username=los_admin;Password=L0sAdmin#2024!;Timeout=30" 
         providerName="Npgsql" />
    
    <!-- Credit database - credit reports and DTI -->
    <add name="los_credit" 
         connectionString="Host=localhost;Port=5433;Database=los_credit;Username=los_admin;Password=L0sAdmin#2024!;Timeout=30" 
         providerName="Npgsql" />
    
    <!-- Compliance database - HMDA, TRID, state disclosures -->
    <add name="los_compliance" 
         connectionString="Host=localhost;Port=5433;Database=los_compliance;Username=los_admin;Password=L0sAdmin#2024!;Timeout=30" 
         providerName="Npgsql" />
    
    <!-- Customer database - borrower data -->
    <add name="los_customer" 
         connectionString="Host=localhost;Port=5433;Database=los_customer;Username=los_admin;Password=L0sAdmin#2024!;Timeout=30" 
         providerName="Npgsql" />
  </connectionStrings>
  
  <appSettings>
    <!-- File paths for batch handoffs -->
    <add key="DataRootPath" value="./data" />
    <add key="InboundPath" value="./data/inbound" />
    <add key="OutboundPath" value="./data/outbound" />
    <add key="BatchPath" value="./data/batch" />
    <add key="ArchivePath" value="./data/archive" />
    
    <!-- Batch schedule (hardcoded but "configurable" - nobody changes these) -->
    <add key="BatchStartTime" value="22:00" />
    <add key="BatchEndTime" value="04:00" />
    <add key="BatchMaxRetries" value="3" />
    <add key="BatchRetryDelaySec" value="30" />
    
    <!-- AUS (Automated Underwriting System) settings -->
    <add key="AusEndpoint" value="http://localhost:5001/api/aus" />
    <add key="AusTimeoutSec" value="60" />
    <add key="AusMaxRetries" value="2" />
    <add key="AusDefaultEngine" value="DU" />  <!-- DU (Fannie Mae) or LP (Freddie Mac) -->
    
    <!-- Credit vendor settings -->
    <add key="CreditVendor" value="CREDITINFO" />
    <add key="CreditVendorEndpoint" value="http://localhost:5002/api/credit" />
    <add key="CreditVendorTimeout" value="45" />
    
    <!-- HMDA reporting -->
    <add key="HmdaReportingYear" value="2024" />
    <add key="HmdaFilingPeriod" value="ANNUAL" />
    <add key="HmdaInstitutionId" value="1234567890" />
    <add key="HmdaLegalEntityName" value="FIRST MERIDIAN HOME LENDING" />
    <add key="HmdaContactName" value="Compliance Officer" />
    <add key="HmdaContactEmail" value="hmda@meridianlending.example" />
    <add key="HmdaContactPhone" value="555-123-4567" />
    
    <!-- TRID settings -->
    <add key="TridLeDeliveryDays" value="3" />
    <add key="TridCdWaitingDays" value="3" />
    <add key="TridChangedCircumstanceDays" value="3" />
    
    <!-- Investor settings -->
    <add key="DefaultInvestorCode" value="FNM" />
    <add key="InvestorShipmentCutoff" value="16:00" />
    
    <!-- General -->
    <add key="ApplicationName" value="MortgageLOS" />
    <add key="ApplicationVersion" value="4.2.17" />
    <add key="Environment" value="DEV" />
    <add key="LogLevel" value="INFO" />
    <add key="LogFilePath" value="./logs" />
    <add key="MaxLogFileSizeMB" value="10" />
    <add key="MaxLogFiles" value="30" />
    
    <!-- Added 2017 - never used but don't remove, something might depend on it -->
    <add key="LegacyMode" value="true" />
    <add key="OldRateEngineEnabled" value="false" />
    
    <!-- Added 2020 for COVID (should be removed but afraid to) -->
    <add key="CovidForbearanceEnabled" value="false" />
    
    <!-- Added 2023 for SCRA -->
    <add key="ScraCheckEnabled" value="true" />
    <add key="ScraDmdcEndpoint" value="https://api.dmdc.osd.mil/scra" />
  </appSettings>
</configuration>
