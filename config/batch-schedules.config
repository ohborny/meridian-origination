<?xml version="1.0" encoding="utf-8"?>
<!--
  Batch Job Schedule Configuration
  ================================
  These schedules are read by the batch job runner. They are also hardcoded
  in the crontab on the production server (which takes precedence).
  
  If you change a schedule here, also update the crontab. Nobody does this.
  See INC-2020-017 where the credit pull job ran twice because someone
  changed the config but not the crontab.
-->
<batchSchedules>
  <schedule jobName="overnight_batch" cronExpression="0 22 * * 1-5" description="Main overnight batch" enabled="true" />
  <schedule jobName="credit_pull" cronExpression="0 6,12,18 * * 1-5" description="Credit pull processing (3x daily)" enabled="true" />
  <schedule jobName="compliance_check" cronExpression="0 23 * * 1-5" description="Compliance check batch" enabled="true" />
  <schedule jobName="investor_report" cronExpression="0 5 * * 1-5" description="Daily investor report generation" enabled="true" />
  <schedule jobName="hmda_sync" cronExpression="0 23 * * 1-5" description="HMDA data sync" enabled="true" />
  <schedule jobName="data_sync" cronExpression="0 22 * * 1-5" description="Cross-database data sync" enabled="true" />
  <!-- Added 2019 but never enabled - too many false positives -->
  <schedule jobName="fair_lending_scan" cronExpression="0 2 * * 1" description="Weekly fair lending scan" enabled="false" />
  <!-- Added 2023 -->
  <schedule jobName="scra_check" cronExpression="0 3 * * 1-5" description="Daily SCRA check for active loans" enabled="true" />
</batchSchedules>
