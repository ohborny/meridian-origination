<?xml version="1.0" encoding="utf-8"?>
<!--
  AUS (Automated Underwriting System) Parameters
  ==============================================
  Configuration for the AUS integration. In production, this connects to
  Fannie Mae's Desktop Underwriter (DU) and Freddie Mac's Loan Product
  Advisor (LPA). In this demo environment, the AUS is simulated.
  
  DO NOT change the endpoint URLs without coordinating with the AUS team.
  Last coordinated change: 2022-06-15 (DU 12.2 upgrade)
-->
<ausConfiguration>
  <engines>
    <engine name="DU" displayName="Desktop Underwriter" vendor="Fannie Mae" enabled="true">
      <endpoint>http://localhost:5001/api/aus/du</endpoint>
      <timeout>60</timeout>
      <maxRetries>2</maxRetries>
      <retryDelay>5</retryDelay>
      <version>12.3</version>
      <!-- DU version history: 10.3 (2017), 11.0 (2019), 12.0 (2021), 12.2 (2022), 12.3 (2024) -->
    </engine>
    <engine name="LP" displayName="Loan Product Advisor" vendor="Freddie Mac" enabled="true">
      <endpoint>http://localhost:5001/api/aus/lp</endpoint>
      <timeout>60</timeout>
      <maxRetries>2</maxRetries>
      <retryDelay>5</retryDelay>
      <version>2.4</version>
    </engine>
    <engine name="GUS" displayName="Guaranteed Underwriting System" vendor="USDA" enabled="true">
      <endpoint>http://localhost:5001/api/aus/gus</endpoint>
      <timeout>90</timeout>
      <maxRetries>1</maxRetries>
      <retryDelay>10</retryDelay>
      <version>1.0</version>
    </engine>
  </engines>
  
  <!-- Default engine by loan type -->
  <defaultEngines>
    <default loanType="CONVENTIONAL" engine="DU" />
    <default loanType="FHA" engine="DU" />
    <default loanType="VA" engine="DU" />
    <default loanType="USDA" engine="GUS" />
    <default loanType="JUMBO" engine="MANUAL" />
    <default loanType="NON_QM" engine="MANUAL" />
  </defaultEngines>
  
  <!-- AUS decision thresholds -->
  <thresholds>
    <!-- Minimum credit scores for AUS approval -->
    <minScore engine="DU" loanType="CONVENTIONAL" score="620" />
    <minScore engine="DU" loanType="FHA" score="580" />
    <minScore engine="DU" loanType="VA" score="580" />
    <minScore engine="GUS" loanType="USDA" score="640" />
    
    <!-- Maximum DTI for AUS approval (can exceed QM 43% with AUS) -->
    <maxDti engine="DU" loanType="CONVENTIONAL" dti="50.0" />
    <maxDti engine="DU" loanType="FHA" dti="56.99" />
    <maxDti engine="DU" loanType="VA" dti="50.0" />
    <maxDti engine="GUS" loanType="USDA" dti="44.0" />
    
    <!-- Maximum LTV for AUS approval -->
    <maxLtv engine="DU" loanType="CONVENTIONAL" ltv="97.0" />
    <maxLtv engine="DU" loanType="FHA" ltv="96.5" />
    <maxLtv engine="DU" loanType="VA" ltv="100.0" />
    <maxLtv engine="GUS" loanType="USDA" ltv="100.0" />
  </thresholds>
  
  <!-- DU Findings simulation parameters (for demo environment) -->
  <simulation>
    <!-- Probability of APPROVE/ELIGIBLE (vs REFER) -->
    <approveProbability minScore="760" probability="0.95" />
    <approveProbability minScore="720" probability="0.85" />
    <approveProbability minScore="680" probability="0.70" />
    <approveProbability minScore="640" probability="0.50" />
    <approveProbability minScore="620" probability="0.35" />
    <approveProbability minScore="580" probability="0.20" />
    <approveProbability minScore="0" probability="0.05" />
    
    <!-- Risk factors that reduce approval probability -->
    <riskFactor factor="high_dti" dtiThreshold="45.0" probabilityReduction="0.15" />
    <riskFactor factor="high_ltv" ltvThreshold="95.0" probabilityReduction="0.10" />
    <riskFactor factor="recent_late" late30Count="2" probabilityReduction="0.20" />
    <riskFactor factor="public_record" probabilityReduction="0.30" />
    <riskFactor factor="thin_file" accountCount="3" probabilityReduction="0.15" />
    <riskFactor factor="high_utilization" utilizationThreshold="70.0" probabilityReduction="0.10" />
  </simulation>
</ausConfiguration>
