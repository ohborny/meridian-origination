# MortgageLOS local environment overrides
#
# Copy this file to .env, replace placeholder values, then load it before
# running the API or batch jobs:
#
#   cp .env.example .env
#   set -a && source .env && set +a
#
# AppConfig reads configuration from config/los.config first. Values in this
# file override it through MORTGAGELOS_CONNECTIONSTRING_<DATABASE_NAME> and
# MORTGAGELOS_SETTING_<SETTING_NAME>. Never commit .env or production values.

# PostgreSQL connection strings. Set passwords to the credentials configured
# for your local PostgreSQL instance or local Docker Compose environment.
MORTGAGELOS_CONNECTIONSTRING_LOS_CORE='Host=localhost;Port=5433;Database=los_core;Username=los_admin;Password=replace-with-local-password;Timeout=30'
MORTGAGELOS_CONNECTIONSTRING_LOS_CREDIT='Host=localhost;Port=5433;Database=los_credit;Username=los_admin;Password=replace-with-local-password;Timeout=30'
MORTGAGELOS_CONNECTIONSTRING_LOS_COMPLIANCE='Host=localhost;Port=5433;Database=los_compliance;Username=los_admin;Password=replace-with-local-password;Timeout=30'
MORTGAGELOS_CONNECTIONSTRING_LOS_CUSTOMER='Host=localhost;Port=5433;Database=los_customer;Username=los_admin;Password=replace-with-local-password;Timeout=30'

# Local runtime and file-handoff settings.
MORTGAGELOS_SETTING_ENVIRONMENT=DEV
MORTGAGELOS_SETTING_LOGLEVEL=INFO
MORTGAGELOS_SETTING_LOGFILEPATH=./logs
MORTGAGELOS_SETTING_DATAROOTPATH=./data
MORTGAGELOS_SETTING_INBOUNDPATH=./data/inbound
MORTGAGELOS_SETTING_OUTBOUNDPATH=./data/outbound
MORTGAGELOS_SETTING_BATCHPATH=./data/batch
MORTGAGELOS_SETTING_ARCHIVEPATH=./data/archive
MORTGAGELOS_SETTING_DOCUMENTROOTPATH=./data/documents

# Local integration endpoints. Leave these pointed at local mocks or services.
MORTGAGELOS_SETTING_AUSENDPOINT=http://localhost:5001/api/aus
MORTGAGELOS_SETTING_CREDITVENDORENDPOINT=http://localhost:5002/api/credit
MORTGAGELOS_SETTING_SCRADMDCENDPOINT=https://api.dmdc.osd.mil/scra
